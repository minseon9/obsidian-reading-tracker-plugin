{
	"name": "obsidian-reading-tracker-plugin",
	"version": "0.1.2",
	"description": "Reading Tracker for Obsidian - Import books, track progress, and analyze reading habits",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"validate": "node scripts/validate-release.mjs",
		"smoke": "node scripts/smoke-test.cjs",
		"verify": "npm run build && npm run lint && npm run validate && npm run smoke",
		"test-vault": "node scripts/setup-test-vault.mjs",
		"deploy": "node scripts/deploy-to-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"reading",
		"books",
		"tracker",
		"library",
		"reading-tracker",
		"book-management"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/minseon9/obsidian-reading-tracker-plugin.git"
	},
	"author": "minseon9",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/node": "^22.20.5",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.50.0"
	},
	"dependencies": {
		"obsidian": "^1.14.4"
	},
	"overrides": {
		"moment": "^2.31.0"
	},
	"bugs": {
		"url": "https://github.com/minseon9/obsidian-reading-tracker-plugin/issues"
	},
	"homepage": "https://github.com/minseon9/obsidian-reading-tracker-plugin"
}
